#!/usr/bin/env bash
set -euo pipefail

source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/common.sh"

to_win_path() {
  local p=$1
  if command -v cygpath >/dev/null 2>&1; then
    cygpath -w "$p"
  else
    # fallback for pure MSYS/Git Bash
    echo "$p" | sed 's|/|\\|g'
  fi
}

if [[ -z "${1:-}" ]]; then
  echo "Syntax: publish-win AppName [runtime]"
  echo "Runtime: win-x64 or win-x86"
  exit 1
fi

app=$1
runtime=${2:-win-x64}

require_supported_app "$app"

case "$runtime" in
  win-x64)
    arch=Win_x64
    ;;
  win-x86)
    arch=Win_x86
    ;;
  *)
    echo "Unsupported Windows runtime: $runtime" >&2
    exit 1
    ;;
esac

version=$(read_version "$app")
proj=$(desktop_csproj "$app")

publishPath="$repo_root/Src/App.$app/$app.Desktop/bin/Publish/$runtime"

outDir=$(output_dir "$version")
outFile="${app}-${version}_${arch}_Setup"
outPath="$outDir/$outFile"

template="$publish_dir/installer.iss"
issFile="$RUNNER_TEMP/${app}-${runtime}.iss"

echo "Runtime     = $runtime"
echo "AppName     = $app"
echo "Version     = $version"
echo "Source      = $repo_root"
echo "Project     = $proj"
echo "PublishPath = $publishPath"
echo "Template    = $template"
echo "Output      = $outPath"
echo

[[ -f "$template" ]] || {
  echo "Missing shared Inno Setup template: $template" >&2
  exit 1
}

iscc=""

for candidate in \
  "$(command -v ISCC.exe 2>/dev/null || true)" \
  "/c/Program Files (x86)/Inno Setup 6/ISCC.exe" \
  "/c/Program Files/Inno Setup 6/ISCC.exe"
do
  if [[ -n "$candidate" && -f "$candidate" ]]; then
    iscc="$candidate"
    break
  fi
done

[[ -n "$iscc" ]] || {
  echo "Inno Setup compiler (ISCC.exe) was not found." >&2
  exit 1
}

rm -rf -- "$publishPath"

dotnet publish "$proj" \
  -r "$runtime" \
  -c Release \
  --self-contained true \
  -p:PublishSingleFile=true \
  -o "$publishPath"

find "$publishPath" \
  -maxdepth 1 \
  -type f \
  -name '*.xml' \
  -delete

[[ -f "$publishPath/$app.exe" ]] || {
  echo "Published executable was not found: $publishPath/$app.exe" >&2
  exit 1
}

mkdir -p "$outDir"
rm -f -- "$outPath"

product=$(read_product "$app")

[[ -n "$product" ]] || {
  echo "Product name is missing for $app." >&2
  exit 1
}

if [[ "$runtime" == "win-x64" ]]; then
  x64="1"
else
  x64="0"
fi

publishPath_win=$(to_win_path "$publishPath")
outDir_win=$(to_win_path "$outDir")
icon_file_win=$(to_win_path "$icon_file")

icon_file="$repo_root/Src/App.$app/Deploy/App.ico"
[[ -f "$icon_file" ]] || {
  echo "Icon not found: $icon_file_win" >&2
  exit 1
}

replace_tokens \
  "$template" \
  "$issFile" \
  "__APP_NAME__" "$product" \
  "__APP_INTERNAL__" "$app" \
  "__APP_VERSION__" "$version" \
  "__PUBLISH_DIR__" "$publishPath_win" \
  "__OUTPUT_DIR__" "$outDir_win" \
  "__OUTPUT_FILE__" "$outFile" \
  "__ICON_FILE__" "$icon_file_win" \
  "__X64__" "$x64"

"$iscc" "$issFile"

[[ -s "$outPath" ]] || {
  echo "Inno Setup package was not created: $outPath" >&2
  exit 1
}

echo "Created: $outPath"
